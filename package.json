{
  "name": "planejamento-financeiro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run supabase/tests",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff --linked",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.ts",
    "accounts:bootstrap": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/accounts.mts bootstrap",
    "accounts:issue-code": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/accounts.mts issue-code"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.11"
  }
}
