# Copie para .env.local e preencha. Nunca faça commit de .env.local.
#
# Variáveis NEXT_PUBLIC_* são embutidas no JavaScript do navegador: coloque
# nelas apenas valores públicos. Todo o resto só existe no servidor.

# ---------------------------------------------------------------------------
# Supabase — públicas (Dashboard > Project Settings > API Keys)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---------------------------------------------------------------------------
# Supabase — PRIVADA (somente servidor; ignora RLS)
# Usada apenas em Server Actions/Route Handlers para: login por username,
# ativação de conta e scripts de bootstrap. Nunca use em código client-side.
# ---------------------------------------------------------------------------
SUPABASE_SECRET_KEY=sb_secret_xxx

# ---------------------------------------------------------------------------
# Autenticação por username
# Domínio dos e-mails técnicos internos (username -> identidade no Supabase
# Auth). Nunca é exibido ao usuário. Veja docs/ARCHITECTURE.md#autenticação.
# ---------------------------------------------------------------------------
AUTH_INTERNAL_EMAIL_DOMAIN=accounts.invalid

# ---------------------------------------------------------------------------
# Web Push (Fase 9) — gere com: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@example.com

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
